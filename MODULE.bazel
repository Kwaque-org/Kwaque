module(
    name = "kwaque",
    version = "0.0.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.2.0.2", dev_dependency = True)
bazel_dep(name = "rules_buf", version = "0.5.4", dev_dependency = True)

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf", dev_dependency = True)
buf.toolchains(
    sha256 = "18f603d3b418f6a1259da4425b04bbe2fbaf60c2b796b98114d961e8736198b9",
    version = "v1.73.0",
)
