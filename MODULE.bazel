bazel_dep(
    name = "rules_boost",
    repo_name = "com_github_nelhage_rules_boost",
)
archive_override(
    module_name = "rules_boost",
    integrity = "sha256-wQsxOxZh1tluc6AXj+ncsYhBSl03uC+hPhBrU6JkupI=",
    patch_strip = 1,
    patches = [
        "//bazel/thirdparty:rules-boost-license.patch",
        "//bazel/thirdparty:rules-boost-uuid-value.patch",
    ],
    strip_prefix = "rules_boost-f5b0f8c904f2487d8f5a9a956d4388724e627210",
    urls = ["https://github.com/nelhage/rules_boost/archive/f5b0f8c904f2487d8f5a9a956d4388724e627210.tar.gz"],
)

boost_dependencies = use_extension(
    "@com_github_nelhage_rules_boost//:boost/repositories.bzl",
    "non_module_dependencies",
)
use_repo(boost_dependencies, "boost")

single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = ["//bazel/thirdparty:abseil-clang-23-lifetime-capture.patch"],
)

single_version_override(
    module_name = "crc32c",
    patch_strip = 1,
    patches = ["//bazel/thirdparty:crc32c-license.patch"],
)

single_version_override(
    module_name = "liburing",
    patch_strip = 1,
    patches = [
        "//bazel/thirdparty:liburing.patch",
        "//bazel/thirdparty:liburing-license.patch",
    ],
)

single_version_override(
    module_name = "lz4",
    patch_strip = 1,
    patches = [
        "//bazel/thirdparty:lz4-namespace-xxhash.patch",
        "//bazel/thirdparty:lz4-license.patch",
    ],
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = [
        "//bazel/thirdparty:protobuf-parse-exception-safety.patch",
        "//bazel/thirdparty:protobuf-accessor-exception-safety.patch",
    ],
)

single_version_override(
    module_name = "xxhash",
    patch_strip = 1,
    patches = [
        "//bazel/thirdparty:xxhash-dispatch.patch",
        "//bazel/thirdparty:xxhash-license.patch",
    ],
