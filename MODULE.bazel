single_version_override(
    module_name = "yaml-cpp",
    patch_strip = 1,
    patches = ["//bazel/thirdparty:yaml-cpp-license.patch"],
)

native_dependencies = use_extension("//bazel:extensions.bzl", "native_dependencies")
use_repo(
    native_dependencies,
    "aarch64_sysroot",
    "c-ares",
    "hwloc",
    "lksctp",
    "openssl",
    "seastar",
    "unordered_dense",
    "x86_64_sysroot",
)

bazel_dep(name = "toolchains_llvm", version = "1.10.0", dev_dependency = True)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    name = "current_llvm_toolchain",
    cxx_standard = {"": "c++23"},
    extra_compile_flags = {
        "linux-aarch64": ["-march=armv8-a+crc+crypto"],
        "linux-x86_64": ["-march=westmere"],
    },
    llvm_version = "23.1.2",
    sha256 = {
        "linux-aarch64": "38f9123ac31b954164d5cee1664ecc45a4db2e9795247635a46d919f2a1fb6ea",
        "linux-x86_64": "5581ff63eb2d1ec8a2cf61847240465a4e177f2ece3d663ef3f43e309d28eb53",
    },
    urls = {
        "linux-aarch64": ["https://github.com/redpanda-data/llvm-project/releases/download/llvmorg-23.1.2/llvm-23.1.2-debian-11-aarch64-2026-09-28.tar.zst"],
        "linux-x86_64": ["https://github.com/redpanda-data/llvm-project/releases/download/llvmorg-23.1.2/llvm-23.1.2-debian-11-x86_64-2026-09-28.tar.zst"],
    },
)
llvm.sysroot(
    name = "current_llvm_toolchain",
    label = "@x86_64_sysroot//sysroot:sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "current_llvm_toolchain",
    label = "@aarch64_sysroot//sysroot:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "current_llvm_toolchain", "current_llvm_toolchain_llvm")

register_toolchains(
    "@current_llvm_toolchain//:all",
    dev_dependency = True,
)
