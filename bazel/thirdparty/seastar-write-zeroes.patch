+future<>
+posix_file_impl::write_zeroes(uint64_t position, uint64_t length) noexcept {
+    // Devices whose file system refused the mode, per shard. The refusal is
+    // reported to every caller; unlike allocate(), it never becomes success.
+    static thread_local std::unordered_set<dev_t> refused;
+    if (refused.contains(_device_id)) {
+        co_await coroutine::return_exception_ptr(std::make_exception_ptr(
+            std::system_error(std::make_error_code(std::errc::operation_not_supported))));
+    }
+    auto sr = co_await engine()._thread_pool->submit<syscall_result<int>>(
+            internal::thread_pool_submit_reason::file_operation, [this, position, length] () mutable {
+        return wrap_syscall<int>(::fallocate(_fd, FALLOC_FL_WRITE_ZEROES, position, length));
+    });
+    if (sr.failed()) {
+        if (sr.error == EOPNOTSUPP) {
+            refused.insert(_device_id);
+        }
+        co_await coroutine::return_exception_ptr(sr.make_system_error_ptr());
+    }
+}
