+future<shared_ptr<file_impl>>
+make_file_impl(int fd, file_open_options options, int flags, struct stat st) noexcept {
+    // Construction borrows fd. Only this boundary releases it on failure,
+    // including a failure after the POSIX base subobject was constructed.
+    return posix_file_impl::make_file_impl_borrowed(fd, std::move(options), flags, st).then_wrapped([fd] (future<shared_ptr<file_impl>> f) {
+        if (f.failed()) {
+            auto failure = f.get_exception();
+            ::close(fd);
+            return make_exception_future<shared_ptr<file_impl>>(failure);
+        }
+        auto impl = f.get();
+        static_cast<posix_file_impl&>(*impl).adopt_fd_ownership();
+        return make_ready_future<shared_ptr<file_impl>>(std::move(impl));
+    });
 }
 
